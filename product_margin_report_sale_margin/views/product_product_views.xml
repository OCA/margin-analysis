<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_margin_view_form" model="ir.ui.view">
        <field
            name="name"
        >product.margin.form.inherit.product_margin_report_sale_margin</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product_margin.view_product_margin_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='margins']//field[@name='expected_margin']"
                position="after"
            >
                <field name="sales_margin" />
            </xpath>
            <xpath
                expr="//page[@name='margins']//field[@name='expected_margin_rate']"
                position="after"
            >
                <field name="sales_margin_rate" widget="progressbar" />
            </xpath>
        </field>
    </record>

    <record id="product_margin_view_tree" model="ir.ui.view">
        <field name="name">product.margin.tree.product_margin_report_sale_margin</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product_margin.view_product_margin_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expected_margin']" position="after">
                <field name="sales_margin" optional="show" />
            </xpath>
            <xpath expr="//field[@name='expected_margin_rate']" position="after">
                <field name="sales_margin_rate" widget="progressbar" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
